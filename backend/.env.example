# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# development | production | test
NODE_ENV=development

# Port the API listens on
PORT=5000

# MongoDB connection string, including the database name.
# Local:  mongodb://localhost:27017/StellaLens
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/StellaLens
MONGODB_URI=mongodb://localhost:27017/StellaLens

CORS_ORIGIN=http://localhost:3000

JWT_SECRET=

JWT_EXPIRES_IN=7d
